{
  "type": "module",
  "name": "esbuild-fix-imports",
  "version": "1.0.0",
  "description": "import/require transformer for EsBuild. Supports TsConfig Paths.",
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.types.json",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignwombat/esbuild-fix-imports.git"
  },
  "keywords": [
    "esbuild",
    "tsconfig",
    "typescript",
    "module",
    "esm",
    "esmodule",
    "ecmascript",
    "cjs",
    "commonjs",
    "import",
    "export",
    "require",
    "folder",
    "directory"
  ],
  "author": "IgnWombat <ignwombat@gmail.com> (https://github.com/ignwombat)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ignwombat/esbuild-fix-imports/issues"
  },
  "homepage": "https://github.com/ignwombat/esbuild-fix-imports#readme",
  "dependencies": {
    "get-tsconfig": "^4.14.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "./package.json",
    "./dist",
    "LICENSE.md",
    "README.md"
  ]
}
